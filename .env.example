APP_NAME=Texora
APP_ENV=development
DEBUG=true
SECRET_KEY=please-change-this-to-a-random-32-char-string-xyz123
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# دیتابیس (چون روی ویندوز psycopg v3 نصب کردی، این پسوند درست است)
DATABASE_URL=postgresql+asyncpg://texora_user:texora_pass@localhost:5432/texora_db
DATABASE_URL_SYNC=postgresql+psycopg://texora_user:texora_pass@localhost:5432/texora_db

# درگاه هوش مصنوعی (اگر کلید نداری، خالی بگذار)
ARVANCLOUD_API_KEY=91d36565-73d7-5427-ab5f-a1dd62243588
AI_GATEWAY_BASE_URL=https://arvancloudai.ir/gateway/models/Gemini-2.5-Flash/yawmTwhzNZFYTi2Qx25yIUqM-0WbqqtfOPsRSaAnprZMrK3yMjxCOlDil1TmxBaAAiUO4y_sYBgkL33pbfBuWJ0sqjQwlXeujpgxB78Vy5VuwmbgAH6Jh5ycVGFXyNtb7F1N4Ooed4vei8-O72_i0xyJ96cUies9ib_81vf-oinYVAxLzh3V5LCnjSSSLdJJEmaF2nt0Kywi7QwaltQwCuv9NLMuaIwp02PDewnHyZfmc-eixhuSq5QNk88R4P9uL2d673TQ/v1
AI_MODEL_NAME=Gemini-2.5-Flash
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=60

# فایل‌ها
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/zip

# CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# نظارت
MODERATION_ENABLED=true
MODERATION_MIN_LENGTH=5
MODERATION_BATCH_SIZE=10